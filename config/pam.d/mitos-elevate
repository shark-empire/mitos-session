#%PAM-1.0
# PAM service for mitos-session's elevation prompts
# (`[elevation].pam_service`). Install as /etc/pam.d/mitos-elevate.
#
# Kept separate from mitos-session on purpose: an admin can give
# elevation prompts a stricter stack (for example pam_faillock with a
# lower threshold) without touching the lock screen.
auth     required   pam_unix.so
account  required   pam_unix.so
